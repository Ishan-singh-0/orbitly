[
 {
  "file": "01-resurrection.jpg",
  "title": "Resurrection",
  "series": "Paintings",
  "note": "My dream-self drowns in societal pressure and ambition, reaching upward desperately. A powerful hand descends from a swirling chaos of icons and cultural symbols, pulsing with strength. In one grasp, they lift me back: my icons become my resurrection."
 },
 {
  "file": "02-kainat.jpg",
  "title": "Kainat",
  "series": "Paintings",
  "note": "Kainat (کائنات) mirrors a world turned upside down, where turmoil reshapes the social order, and each generation meets the same storm in different silence."
 },
 {
  "file": "03-uptown-funk.jpg",
  "title": "Uptown Funk",
  "series": "Paintings",
  "note": "In the weary haze of city melancholy, her golden eyes burn like the last ember worth finding. All around her, shadows carry unspoken weight. Yet she stands untouched, her quiet smile and delicate bow a stubborn reminder that some light refuses to go out."
 },
