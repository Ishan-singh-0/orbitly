# Copy these into your host's environment settings. Never commit real values.

# ── Required in production ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Your public address, no trailing slash. Used for canonical URLs, sitemap, emails and — importantly —
# for validating the Host header and building email links. Set it or emails won't be sent in production.
SITE_URL=https://your-domain.com
# Where accounts, services, messages, sessions and backups live. Mount a persistent disk/volume here.
DATA_DIR=/data

# ── Behind a proxy / platform that terminates HTTPS (Render, Railway, Fly, Caddy, nginx, Cloudflare) ──
TRUST_PROXY=1
# How many trusted proxies sit in front of the app (default 1). Used to read the real client IP from X-Forwarded-For.
# Cloudflare in front of another proxy = 2.
TRUST_PROXY_HOPS=1
# Redirect any plain-HTTP request to HTTPS (needs TRUST_PROXY=1).
FORCE_HTTPS=1

# ── Email (optional but strongly recommended) ─────────────────────────────────
# Without a key, production sends NO email: password reset is unavailable and verification is not enforced.
# Create a free account at https://resend.com, verify your sending domain, and paste an API key:
RESEND_API_KEY=
# Must be an address on the domain you verified, e.g.  Tweak’d <noreply@your-domain.com>
MAIL_FROM=Tweak’d <noreply@your-domain.com>

# ── Admin / moderation (optional) ─────────────────────────────────────────────
# 32+ random characters enables the protected admin API used by tools/admin.js. Leave empty to disable it entirely.
#   generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ── Secrets & bot protection (optional) ───────────────────────────────────────
# Signs captcha/2FA tokens and encrypts 2FA secrets. Leave empty to auto-generate DATA_DIR/secret.key (back it up!).
APP_SECRET=
# Proof-of-work captcha: set to off to disable, or raise CAPTCHA_BITS (default 18) to make it harder.
CAPTCHA=on
CAPTCHA_BITS=18

# ── Demo accounts ─────────────────────────────────────────────────────────────
# Local development creates a demo buyer, artist and admin automatically. Set 0 to turn that off.
# Never set 1 in production unless you change those passwords (see README).
DEMO_SEED=0

# ── Payments (optional) ───────────────────────────────────────────────────────
# Set BOTH to switch on online payment through Stripe's hosted checkout. Start with test keys (sk_test_...).
# Add a webhook in the Stripe dashboard: https://your-domain.com/api/stripe/webhook
# events: checkout.session.completed, charge.refunded. Paste its signing secret (whsec_...) below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Percent kept by the platform on each paid order
PLATFORM_FEE_PERCENT=10

# ── Branding / legal pages ────────────────────────────────────────────────────
COMPANY_NAME=Your Company Name
CONTACT_EMAIL=hello@your-domain.com
# Extra hostnames that may serve the site (comma separated), e.g. a www alias. SITE_URL's host is always allowed.
ALLOWED_HOSTS=
